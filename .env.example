# ============================================================================
# n8n (local) — Copie ce fichier en .env et remplis les valeurs.
# cp .env.example .env && nano .env
# ============================================================================

# --- Secrets du sandbox n8n (génère tes propres valeurs) ---
SANDBOX_API_KEYS=change-me-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key
# Doit correspondre à une valeur de SANDBOX_API_KEYS ci-dessus (auth n8n -> sandbox)
N8N_SANDBOX_SERVICE_API_KEY=change-me-api-key

# --- Web search : SearXNG bundlé (local, aucune API externe) ---
SEARXNG_SECRET=change-me-searxng-secret
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# --- Task Runners (external mode — isolation du code JS/Python) ---
N8N_RUNNERS_AUTH_TOKEN=n8n-runners-auth-token-a3f8b2c1d4e5f6a7b8c9d0e1f2a3b4c5

# --- Seule API externe : OpenRouter pour les fonctions AI ---
# Récupère ta clé sur https://openrouter.ai/keys
N8N_INSTANCE_AI_MODEL_API_KEY=sk-or-xxx

# --- Configuration n8n AI Assistant (éditable ici) ---
N8N_ENABLED_MODULES=instance-ai
# Modèle par défaut via OpenRouter. Format : openrouter/<model-id>
# Ex. : openrouter/deepseek/deepseek-chat, openrouter/openai/gpt-4o
N8N_INSTANCE_AI_MODEL=openrouter/anthropic/claude-3.7-sonnet
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox:latest
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

# --- PostgreSQL (Alpine) : source unique pour n8n ET le service postgres ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=a3f8b2c1d4e5f6a7b8c9d0e1f2a3b4c5
DB_POSTGRESDB_SCHEMA=public

# ============================================================================
# Optionnel : endpoint OpenAI-like / OpenAI-compatible (Ollama, LM Studio, vLLM…)
# Décommente et adapte pour remplacer OpenRouter (aucune clé externe requise
# si le serveur local n'en demande pas).
# N8N_INSTANCE_AI_MODEL=openai/gpt-4o
# N8N_INSTANCE_AI_MODEL_URL=http://host.docker.internal:1234/v1
# N8N_INSTANCE_AI_MODEL_API_KEY=sk-no-key   # souvent optionnel en local
# ============================================================================
