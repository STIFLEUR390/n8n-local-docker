# ============================================================================
# docker-compose.dokploy.env.example — version AVEC IA
# Variables pour docker-compose.dokploy.yml (Dokploy → onglet Environment).
# Génère tes propres secrets : openssl rand -hex 32
# ============================================================================

# --- Sandbox n8n (obligatoire : la sandbox démarre avec ce fichier) ---
SANDBOX_API_KEYS=change-me-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key
# Doit correspondre à SANDBOX_API_KEYS
N8N_SANDBOX_SERVICE_API_KEY=change-me-api-key

# --- SearXNG (web search de l'Assistant, local) ---
SEARXNG_SECRET=change-me-searxng-secret
# N8N_INSTANCE_AI_SEARXNG_URL a un défaut dans le compose (http://searxng:8080)

# --- AI — OpenRouter (https://openrouter.ai/keys) ---
N8N_INSTANCE_AI_MODEL_API_KEY=sk-or-xxx
# Modèle par défaut dans le compose (openrouter/<provider>/<model>) —
# décommente pour choisir un autre modèle :
# N8N_INSTANCE_AI_MODEL=openrouter/deepseek/deepseek-chat

# --- PostgreSQL ---
# Rien à déclarer : le compose a des défauts cohérents avec le service
# postgres (DB_TYPE=postgresdb, host=postgres…). DB_POSTGRESDB_USER et
# DB_POSTGRESDB_PASSWORD sont hardcodés dans le compose — ne pas les définir.
